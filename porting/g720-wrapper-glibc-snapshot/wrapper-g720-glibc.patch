+static void
+InterceptorState_Cleanup(InterceptorState* state)
+{
+   VkDevice device = state->device;
+
+   if (device == VK_NULL_HANDLE)
+      return;
+
+   if (state->pipeline != VK_NULL_HANDLE) {
+      WCHECKV(DestroyPipeline(device, state->pipeline, NULL));
+      state->pipeline = VK_NULL_HANDLE;
+   }
+
+   if (state->pipelineLayout != VK_NULL_HANDLE) {
+      WCHECKV(DestroyPipelineLayout(device, state->pipelineLayout, NULL));
+      state->pipelineLayout = VK_NULL_HANDLE;
+   }
+
+   if (state->descriptorSetLayout != VK_NULL_HANDLE) {
+      WCHECKV(DestroyDescriptorSetLayout(device,
+                                         state->descriptorSetLayout,
+                                         NULL));
+      state->descriptorSetLayout = VK_NULL_HANDLE;
+   }
+
+   if (state->constantsBuffer != VK_NULL_HANDLE) {
+      WCHECKV(DestroyBuffer(device, state->constantsBuffer, NULL));
+      state->constantsBuffer = VK_NULL_HANDLE;
+   }
+
+   if (state->constantsBufferMemory != VK_NULL_HANDLE) {
+      WCHECKV(FreeMemory(device, state->constantsBufferMemory, NULL));
+      state->constantsBufferMemory = VK_NULL_HANDLE;
+   }
+
+   state->device = VK_NULL_HANDLE;
+}
